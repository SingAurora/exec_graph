[Unit]
Description=Exec Graph web and API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=execgraph
Group=execgraph
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory=/opt/exec-graph/current/backend
Environment=EXEC_GRAPH_CONFIG=/etc/exec-graph/config.yaml
ExecStart=/opt/exec-graph/current/backend/bin/exec-graph
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0027

[Install]
WantedBy=multi-user.target
